    //tabulization way(bottom up iterative way)
    public static int fabonachi(int n,int[] dp){
        //step 1: initilize with base case
        dp[0]=0;
        dp[1]=1;
        //step 2: run in loop
        for(int i=2;i<=n;i++){
            //change function into i
            dp[i]=dp[i-1]+dp[i-2];
        }
        
        return dp[n];
        
    }
    
    public static void main(String[] args) {
      Scanner sc=new Scanner(System.in);
      int n=sc.nextInt();
      //step 1: create a array for number of subproblems
      int[] dp=new int[n+1];
      Arrays.fill(dp,-1);
      System.out.println(fabonachi(n,dp));
      
    }
